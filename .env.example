# Copy to `.env` and adjust. Every setting can also be passed as an environment variable.

# PostgreSQL + pgvector. Three ways to run it locally:
#   1. Embedded, no Docker (needs the dev extra; data lives in ./.pgdata; stop with `reviewradar db stop`):
#        REVIEWRADAR_DATABASE_URL=pgserver:///.pgdata
#   2. Docker (see docker-compose.yml):
#        REVIEWRADAR_DATABASE_URL=postgresql+asyncpg://reviewradar:reviewradar@localhost:5432/reviewradar
#   3. SQLite for ingestion and enrichment only (search requires PostgreSQL):
#        REVIEWRADAR_DATABASE_URL=sqlite+aiosqlite:///./reviewradar.db
REVIEWRADAR_DATABASE_URL=pgserver:///.pgdata

REVIEWRADAR_LOG_LEVEL=INFO
REVIEWRADAR_CATALOG_PATH=config/apps.yaml

# Ingestion tuning
REVIEWRADAR_INGESTION__MAX_CONCURRENT_FETCHES=4
REVIEWRADAR_INGESTION__GOOGLE_PLAY_PAGE_SIZE=200
REVIEWRADAR_INGESTION__PAGE_DELAY_SECONDS=0.5
REVIEWRADAR_INGESTION__MAX_ATTEMPTS=5
REVIEWRADAR_INGESTION__DEFAULT_LOOKBACK_DAYS=30
# Re-scan window behind the cursor, absorbing store moderation delays (up to ~72h).
REVIEWRADAR_INGESTION__INCREMENTAL_OVERLAP_HOURS=72
# Per-store overrides (JSON). Google Play publishes reviews up to ~2 weeks late.
REVIEWRADAR_INGESTION__OVERLAP_HOURS_BY_STORE={"google_play": 336}
REVIEWRADAR_INGESTION__MAX_REVIEWS_PER_MARKET=5000

# Enrichment: language detection and embeddings
REVIEWRADAR_ENRICHMENT__EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# REVIEWRADAR_ENRICHMENT__EMBEDDING_DEVICE=cuda
REVIEWRADAR_ENRICHMENT__EMBEDDING_BATCH_SIZE=64
REVIEWRADAR_ENRICHMENT__REVIEW_BATCH_SIZE=512
REVIEWRADAR_ENRICHMENT__MIN_LANGUAGE_CONFIDENCE=0.9
# Lower bar when detection agrees with the store hint or the storefront's main language.
REVIEWRADAR_ENRICHMENT__MIN_CORROBORATED_LANGUAGE_CONFIDENCE=0.5
REVIEWRADAR_ENRICHMENT__MIN_LANGUAGE_CHARS=20
# E5-style models expect instruction prefixes:
# REVIEWRADAR_ENRICHMENT__DOCUMENT_PREFIX="passage: "
# REVIEWRADAR_ENRICHMENT__QUERY_PREFIX="query: "

# Translation: local machine translation into English (M2M100, MIT licence, ~2 GB download on first use)
REVIEWRADAR_TRANSLATION__MODEL=facebook/m2m100_418M
# REVIEWRADAR_TRANSLATION__DEVICE=cuda
REVIEWRADAR_TRANSLATION__TARGET_LANGUAGE=en
REVIEWRADAR_TRANSLATION__BATCH_SIZE=16
REVIEWRADAR_TRANSLATION__NUM_BEAMS=2

# Search
# Results each retriever contributes before reciprocal rank fusion, and the fusion damping constant.
REVIEWRADAR_SEARCH__CANDIDATE_POOL_SIZE=50
REVIEWRADAR_SEARCH__RRF_K=60

# Topic discovery: k-means over stored review embeddings (run `enrich` first; `translate` improves labels)
REVIEWRADAR_TOPICS__TOPIC_COUNT=20
# Only reviews rated at most this take part (use `reviewradar topics <app> --all-ratings` for every rating).
REVIEWRADAR_TOPICS__MAX_RATING=3
REVIEWRADAR_TOPICS__MIN_WORDS=4
REVIEWRADAR_TOPICS__KEYWORDS_PER_TOPIC=6
REVIEWRADAR_TOPICS__SEED=0
# Discovery refuses to run on fewer eligible reviews; older runs beyond this count are deleted.
REVIEWRADAR_TOPICS__MIN_REVIEWS=50
REVIEWRADAR_TOPICS__RUNS_TO_KEEP=3

# Reply drafting: datasets, QLoRA fine-tuning and local generators (install the "finetune" extra)
REVIEWRADAR_REPLIES__BASE_MODEL=Qwen/Qwen3-1.7B
REVIEWRADAR_REPLIES__ADAPTER_DIR=models/replies/qwen3-1.7b-lora
REVIEWRADAR_REPLIES__GUIDELINES_PATH=config/reply_guidelines.md
REVIEWRADAR_REPLIES__DATASET_DIR=data/replies/dataset
# Held-out shares: written references are scarce and in-domain, so more of them are held out.
REVIEWRADAR_REPLIES__EVAL_FRACTION_PUBLISHED=0.1
REVIEWRADAR_REPLIES__EVAL_FRACTION_WRITTEN=0.35
# Training defaults fit a 4 GB laptop GPU (effective batch 16).
REVIEWRADAR_REPLIES__TRAINING__EPOCHS=2
REVIEWRADAR_REPLIES__TRAINING__BATCH_SIZE=4
REVIEWRADAR_REPLIES__TRAINING__GRADIENT_ACCUMULATION_STEPS=4
REVIEWRADAR_REPLIES__TRAINING__LEARNING_RATE=0.0002
REVIEWRADAR_REPLIES__TRAINING__LORA_RANK=16

# Topic spikes: tested per store and market on topic share of critical reviews
REVIEWRADAR_ANOMALIES__MIN_COUNT=5
REVIEWRADAR_ANOMALIES__MIN_LIFT=3.0
# False-alarm rate across all topic-days tested, split evenly across them (Bonferroni)
REVIEWRADAR_ANOMALIES__FAMILY_ALPHA=0.01
REVIEWRADAR_ANOMALIES__MIN_USABLE_DAYS=5
# Only critical reviews are tested, even when a topic run covers every rating
REVIEWRADAR_ANOMALIES__MAX_RATING=3
# Daily monitor: each day judged on earlier days only, with a false-alarm budget per day
REVIEWRADAR_ANOMALIES__BASELINE_DAYS=28
REVIEWRADAR_ANOMALIES__MIN_BASELINE_DAYS=5
REVIEWRADAR_ANOMALIES__DAILY_ALPHA=0.01
REVIEWRADAR_ANOMALIES__INCIDENT_GAP_DAYS=1
# Blame a release when most of an incident is on a version that was rare the week before
REVIEWRADAR_ANOMALIES__RELEASE_SHARE=0.5
REVIEWRADAR_ANOMALIES__MAX_PRIOR_VERSION_SHARE=0.25
REVIEWRADAR_ANOMALIES__NEW_VERSION_DAYS=7

